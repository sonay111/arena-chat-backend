DATABASE_URL=postgres://postgres:postgres@localhost:5433/chatdb

# CRM webhook auth (see src/webhooks/auth.ts). Confirmed with Satyam
# (2026-08): HMAC-SHA256. X-Webhook-Signature is
# hex(HMAC-SHA256(raw request body, this secret)). No off switch — every
# webhook request must be signed, unlike the old placeholder shared-secret
# check this replaced.
WEBHOOK_SIGNING_SECRET=your-hmac-signing-secret-here

# CRM API client (src/crm/) — reads player data on demand. Staging and
# production have different values here; never hardcode them in code.
# Real staging values live only in .env, from docs/Staging Data Api's.pdf.
CRM_API_BASE_URL=https://your-crm-base-url/v1
CRM_API_TOKEN=your-crm-token-here

# TEMPORARY, local/dev testing only. Off by default (leave empty/unset).
# Bypasses the join handler's CRM identity lookup (src/server.ts) — needed
# until our server's IP is allowlisted, since every real lookup fails with
# CrmIpNotAllowedError until then. Setting this to true logs a loud warning
# on startup and on every join — must never be true in a real deployment.
SKIP_IDENTITY_CHECK=

# AI layer (src/ai/) — Anthropic API key. Not obtained yet; the code is
# structured so adding the real value here is the only step needed to
# start testing.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Live odds feed (src/odds-feed/) — socket.io connection, staging.
# websocket transport only; token goes in the `auth` handshake payload,
# not a header.
ODDS_FEED_URL=https://your-odds-feed-base-url
ODDS_FEED_PATH=/v1/odds/socket.io
ODDS_FEED_TOKEN=your-odds-feed-token-here
