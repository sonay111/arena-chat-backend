# Supabase (temporary DB, will be replaced by AWS later)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq (AI calls). Model used: llama-3.1-8b-instant
GROQ_API_KEY=

# OpenRouter — currently unused (blocks requests when account balance is negative,
# even for free models). Kept here in case we switch back; see src/ai/client.ts.
OPENROUTER_API_KEY=

# Withdrawal-delay feed, polled every POLL_INTERVAL_MINUTES
WITHDRAWAL_FEED_URL=

# Optional testing/staging helpers. Leave both blank in production.
# TEST_USER_IDS: comma-separated userIds. If set, only these customers are processed.
TEST_USER_IDS=

# Server
PORT=3000
POLL_INTERVAL_MINUTES=2

# (logs only) unless SUPPORT_CHAT_SEND=true and all three credentials are set.
# Only customers in TEST_USER_IDS are ever messaged.
SUPPORT_CHAT_API_BASE_URL=
SUPPORT_CHAT_API_KEY=
SUPPORT_CHAT_TENANT_DOMAIN=
SUPPORT_CHAT_SEND=false

# Shared secret arena-chat-backend sends (header x-cx-agent-secret) when forwarding a customer's
# widget message to POST /support-chat/inbound. Leave empty and the route refuses everything.
CX_AGENT_INBOUND_SECRET=

# Optional: reach a customer under a different id in the widget. Format "agentId:supportChatUserId"
# (comma-separated for several). Used when the withdrawal feed's player (e.g. a QA player) is not
# the same id as the CrazyBet test account. The TEST_USER_IDS allowlist still uses the agent's own id.
SUPPORT_CHAT_CUSTOMER_MAP=

# Old demo feature: when a payment gateway (Hero/Crypto) is stale for 15+ minutes, open a visible
# browser and send an alert into the CrazyBet chat widget. OFF unless exactly "true".
GATEWAY_BROWSER_ALERTS=false

# Secret CrazyBet signs customer-reply webhooks with (X-Arena365-Signature). Needed only if CrazyBet
# delivers replies straight to this agent's POST /support-chat/webhook. Unset = that route refuses all.
SUPPORT_CHAT_WEBHOOK_SECRET=

# When exactly "true", ANY customer may be messaged (each withdrawal goes to its own owner).
# Otherwise only TEST_USER_IDS may be. Support Chat itself refuses customers that do not exist there.
SUPPORT_CHAT_ALLOW_ALL_CUSTOMERS=false

# Automatic "still pending" reminders: wait this many minutes between them, and send at most this
# many per withdrawal (then stop until the status changes). Defaults: 15 and 3.
CHECKIN_INTERVAL_MINUTES=15
MAX_CHECKINS=3

# After the agent messages a customer about one kind of problem, wait this many minutes before
# opening a NEW kind of problem with them (so they are not hit by two messages at once). 0 = off.
# Two problems of the same kind (for example two delayed withdrawals) are never delayed.
DISPATCH_CROSS_TYPE_COOLDOWN_MINUTES=5
